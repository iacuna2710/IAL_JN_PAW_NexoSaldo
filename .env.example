# Copie este archivo como .env (en la misma carpeta que docker-compose.yml) y complete los valores.
# .env está en .gitignore: sus claves nunca se suben al repositorio.

# Clave de Gemini (gratis en https://aistudio.google.com/apikey). Vacía = asistente deshabilitado.
GEMINI_API_KEY=

# Contraseña del usuario sa de SQL Server en docker-compose (opcional; por defecto Paw_Jueves2026)
DB_PASSWORD=
