@model PreferenciasModel

<div class="page-header">
  <div>
    <h1 class="page-title">Settings</h1>
    <p class="page-subtitle">Seguridad, preferencias y apariencia</p>
  </div>
</div>

<partial name="_MensajesCuenta" />

<div class="row g-4">
  <!-- Cambiar contraseña -->
  <div class="col-12 col-lg-6">
    <div class="card p-4 border-light shadow-sm h-100">
      <h2 class="card-title h5 mb-4"><i class="bi bi-shield-lock"></i> Cambiar contraseña</h2>

      <form asp-controller="Cuenta" asp-action="CambiarContrasenna" method="post">
        <div class="mb-3">
          <label for="ContrasennaActual" class="form-label-custom">Contraseña actual</label>
          <input id="ContrasennaActual" name="ContrasennaActual" type="password" class="form-control form-control-custom"
                 autocomplete="current-password" required>
        </div>
        <div class="mb-3">
          <label for="ContrasennaNueva" class="form-label-custom">Contraseña nueva</label>
          <input id="ContrasennaNueva" name="ContrasennaNueva" type="password" class="form-control form-control-custom"
                 autocomplete="new-password" minlength="8" maxlength="100" required>
          <p class="text-secondary fs-xs mt-1 mb-0">Mínimo 8 caracteres.</p>
        </div>
        <div class="mb-4">
          <label for="ConfirmarContrasenna" class="form-label-custom">Confirmar contraseña nueva</label>
          <input id="ConfirmarContrasenna" name="ConfirmarContrasenna" type="password" class="form-control form-control-custom"
                 autocomplete="new-password" minlength="8" maxlength="100" required>
        </div>
        <button type="submit" class="btn-custom btn-custom-primary">
          <i class="bi bi-key"></i> Cambiar contraseña
        </button>
      </form>
    </div>
  </div>

  <div class="col-12 col-lg-6 d-flex flex-column gap-4">
    <!-- Preferencias -->
    <div class="card p-4 border-light shadow-sm">
      <h2 class="card-title h5 mb-4"><i class="bi bi-sliders"></i> Preferencias</h2>

      <form asp-controller="Cuenta" asp-action="Preferencias" method="post">
        <label for="Moneda" class="form-label-custom">Moneda para los montos</label>
        <select id="Moneda" name="Moneda" class="form-select form-select-custom mb-4">
          <option value="CRC" selected="@(Model.Moneda == "CRC")">Colón costarricense (₡)</option>
          <option value="USD" selected="@(Model.Moneda == "USD")">Dólar estadounidense ($)</option>
          <option value="EUR" selected="@(Model.Moneda == "EUR")">Euro (€)</option>
        </select>
        <button type="submit" class="btn-custom btn-custom-primary">
          <i class="bi bi-save"></i> Guardar preferencias
        </button>
      </form>
    </div>

    <!-- Apariencia -->
    <div class="card p-4 border-light shadow-sm">
      <h2 class="card-title h5 mb-3"><i class="bi bi-palette"></i> Apariencia</h2>
      <div class="d-flex align-items-center gap-3">
        <partial name="_ThemeToggle" model="@string.Empty" />
        <span class="text-secondary small">Cambie entre modo claro y oscuro. Se recuerda en este navegador.</span>
      </div>
    </div>
  </div>
</div>
