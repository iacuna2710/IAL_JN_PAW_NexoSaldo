@using PAW_Jueves.Services
@model CategoriaFormModel
@{
    var moneda = Context.Session.GetString(ClavesSesion.Moneda);
}

<div class="page-header">
  <div>
    <h1 class="page-title">Editar categoría</h1>
    <p class="page-subtitle">@Model.Nombre · @(Model.Tipo == "I" ? "Ingreso" : "Gasto")</p>
  </div>
</div>

<partial name="_Mensajes" />

<div class="row">
  <div class="col-12 col-lg-6">
    <div class="card p-4 border-light shadow-sm">
      <form asp-action="Editar" asp-route-id="@Model.IdCategoria" method="post">
        <input type="hidden" name="Tipo" value="@Model.Tipo">
        <div class="mb-3">
          <label for="Nombre" class="form-label-custom">Nombre</label>
          <input id="Nombre" name="Nombre" class="form-control form-control-custom" value="@Model.Nombre" required minlength="2" maxlength="50">
        </div>
        <div class="mb-3">
          <label for="Color" class="form-label-custom">Color</label>
          <input id="Color" name="Color" type="color" class="form-control form-control-color" value="@Model.Color">
        </div>
        @if (Model.Tipo == "G")
        {
          <div class="mb-3">
            <label for="PresupuestoMensual" class="form-label-custom">Presupuesto mensual (@FormatoMoneda.Simbolo(moneda))</label>
            <input id="PresupuestoMensual" name="PresupuestoMensual" type="number" min="0.01" step="0.01"
                   class="form-control form-control-custom" placeholder="Sin presupuesto"
                   value="@Model.PresupuestoMensual?.ToString(System.Globalization.CultureInfo.InvariantCulture)">
          </div>
        }
        <div class="form-check mb-4">
          <input class="form-check-input" type="checkbox" id="Estado" name="Estado" value="true" @(Model.Estado ? "checked" : "")>
          <input type="hidden" name="Estado" value="false">
          <label class="form-check-label" for="Estado">Activa (se puede usar en movimientos nuevos)</label>
        </div>
        <div class="d-flex gap-2">
          <button type="submit" class="btn-custom btn-custom-primary"><i class="bi bi-save"></i> Guardar</button>
          <a asp-action="Index" class="btn-custom btn-custom-light">Cancelar</a>
        </div>
      </form>
    </div>
  </div>
</div>
