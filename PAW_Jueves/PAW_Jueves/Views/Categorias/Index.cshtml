@using PAW_Jueves.Services
@model List<CategoriaModel>
@{
    string moneda = ViewBag.Moneda;
}

<div class="page-header">
  <div>
    <h1 class="page-title">Categorías</h1>
    <p class="page-subtitle">Organice sus ingresos y gastos, y defina un presupuesto mensual por categoría</p>
  </div>
</div>

<partial name="_Mensajes" />

<div class="row g-4">
  <div class="col-12 col-xl-8">
    <div class="card p-4 border-light shadow-sm">
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead>
            <tr>
              <th>Categoría</th>
              <th>Tipo</th>
              <th class="text-end">Presupuesto mensual</th>
              <th class="text-center">Movimientos</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var c in Model)
            {
              <tr class="@(c.Estado ? "" : "opacity-50")">
                <td>
                  <span class="d-inline-block rounded-circle me-2 align-middle" style="width: 12px; height: 12px; background: @c.Color"></span>
                  @c.Nombre
                  @if (!c.Estado)
                  {
                    <span class="badge text-bg-secondary ms-1">Desactivada</span>
                  }
                </td>
                <td>
                  @if (c.Tipo == "I")
                  {
                    <span class="badge text-bg-success">Ingreso</span>
                  }
                  else
                  {
                    <span class="badge text-bg-danger">Gasto</span>
                  }
                </td>
                <td class="text-end">@(c.PresupuestoMensual is decimal p ? FormatoMoneda.Mostrar(p, moneda) : "—")</td>
                <td class="text-center">@c.CantidadMovimientos</td>
                <td class="text-end text-nowrap">
                  <a asp-action="Editar" asp-route-id="@c.IdCategoria" class="btn btn-sm btn-outline-secondary" title="Editar">
                    <i class="bi bi-pencil"></i>
                  </a>
                  @if (c.Estado)
                  {
                    <form asp-action="Eliminar" asp-route-id="@c.IdCategoria" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar la categoría @c.Nombre? Si tiene movimientos, se desactivará.');">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                    </form>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-12 col-xl-4">
    <div class="card p-4 border-light shadow-sm">
      <h2 class="card-title h5 mb-4"><i class="bi bi-plus-circle"></i> Nueva categoría</h2>
      <form asp-action="Crear" method="post">
        <div class="mb-3">
          <label for="Nombre" class="form-label-custom">Nombre</label>
          <input id="Nombre" name="Nombre" class="form-control form-control-custom" required minlength="2" maxlength="50">
        </div>
        <div class="mb-3">
          <label for="Tipo" class="form-label-custom">Tipo</label>
          <select id="Tipo" name="Tipo" class="form-select form-select-custom">
            <option value="G">Gasto</option>
            <option value="I">Ingreso</option>
          </select>
        </div>
        <div class="mb-3">
          <label for="Color" class="form-label-custom">Color</label>
          <input id="Color" name="Color" type="color" class="form-control form-control-color" value="#4dabf7">
        </div>
        <div class="mb-4" id="grupo-presupuesto">
          <label for="PresupuestoMensual" class="form-label-custom">Presupuesto mensual (@FormatoMoneda.Simbolo(moneda))</label>
          <input id="PresupuestoMensual" name="PresupuestoMensual" type="number" min="0.01" step="0.01"
                 class="form-control form-control-custom" placeholder="Opcional">
          <p class="text-secondary fs-xs mt-1 mb-0">Se le avisará al llegar al 80 % y al 100 %.</p>
        </div>
        <button type="submit" class="btn-custom btn-custom-primary w-100"><i class="bi bi-save"></i> Crear categoría</button>
      </form>
    </div>
  </div>
</div>

<script>
  // Solo las categorías de gasto tienen presupuesto
  (function () {
    const tipo = document.getElementById('Tipo');
    const grupo = document.getElementById('grupo-presupuesto');
    function actualizar() { grupo.hidden = tipo.value !== 'G'; }
    tipo.addEventListener('change', actualizar);
    actualizar();
  })();
</script>
