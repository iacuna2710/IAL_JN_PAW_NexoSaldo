<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <partial name="_ThemeHead" />
  <title>Proyecto Web JN</title>

  <link rel="icon" type="image/png" href="~/images/favicon.ico">
  <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css">
  <link rel="stylesheet" href="~/lib/apexcharts/apexcharts.css">
  <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css">
  <link rel="stylesheet" href="~/css/main.css" asp-append-version="true">
</head>

<body>

  <!-- ==========================================
  START: Sidebar Component
  Highly polished, dark-green navigation
  ========================================== -->
  <div class="sidebar-wrapper" id="sidebar">
    <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
      <i class="bi bi-asterisk"></i>
      <span>Spark Admin</span>
    </a>

    <!-- Navigation Menu -->
    <div class="flex-grow-1 overflow-y-auto">
      <!-- Group: Menu -->
      <div class="sidebar-menu-section">
        <div class="sidebar-menu-title">Menu</div>
        <ul class="sidebar-menu-list">
          <li class="sidebar-menu-item">
            <a asp-controller="Home" asp-action="Index" class="sidebar-menu-link" id="menu-overview" title="Dashboard">
              <i class="bi bi-grid-fill"></i>
              <span>Dashboard</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Grupo: Finanzas (módulo de gastos personales) -->
      <div class="sidebar-menu-section">
        <div class="sidebar-menu-title">Finanzas</div>
        <ul class="sidebar-menu-list">
          <li class="sidebar-menu-item">
            <a asp-controller="Movimientos" asp-action="Index" class="sidebar-menu-link" id="menu-movimientos" title="Movimientos">
              <i class="bi bi-arrow-left-right"></i>
              <span>Movimientos</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a asp-controller="Categorias" asp-action="Index" class="sidebar-menu-link" id="menu-categorias" title="Categorías">
              <i class="bi bi-tags"></i>
              <span>Categorías</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- ==========================================
  START: Main Content Area
  ========================================== -->
  <div class="main-wrapper">

    <!-- START: Top Navbar Component -->
    <header class="navbar-custom">
      <div class="navbar-left">
        <!-- Desktop sidebar toggle (visible on large screens only) -->
        <button class="btn-desktop-toggle d-none d-xl-flex align-items-center justify-content-center me-3"
                id="desktop-sidebar-toggle" aria-label="Minimize Sidebar">
          <i class="bi bi-chevron-bar-left"></i>
        </button>
        <!-- Mobile sidebar toggle -->
        <button class="sidebar-toggle-btn me-2" id="sidebar-toggle" aria-label="Toggle Navigation">
          <i class="bi bi-list"></i>
        </button>
      </div>

      <!-- Mid navbar: search pill -->
      <div class="navbar-search-wrapper">
        <input type="text" class="navbar-search-input" placeholder="..." id="main-search">
        <button class="navbar-search-btn" aria-label="Search">
          <i class="bi bi-search"></i>
        </button>
      </div>

      <!-- Right actions -->
      <div class="navbar-actions">
        <!-- Theme toggle (claro / oscuro) -->
        <partial name="_ThemeToggle" model="@string.Empty" />

        <!-- Profile Dropdown -->
        <div class="dropdown ms-2">
          <button class="navbar-profile-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"
                  aria-expanded="false" id="profile-dropdown">
            @{
              // Foto de la sesión; si el usuario no ha subido ninguna, se usa la imagen por defecto
              var fotoPerfil = Context.Session.GetString(ClavesSesion.FotoPerfil);
            }
            <img src="@(string.IsNullOrEmpty(fotoPerfil) ? Url.Content("~/images/avatar.png") : fotoPerfil)" alt="Foto de perfil" class="navbar-profile-img">
            <span class="navbar-profile-name d-none d-md-inline">@Context.Session.GetString(ClavesSesion.NombreCompleto)</span>
            <i class="bi bi-chevron-down navbar-profile-caret"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end dropdown-menu-profile" aria-labelledby="profile-dropdown">
            <li><a class="dropdown-item" asp-controller="Cuenta" asp-action="MiCuenta"><i class="bi bi-person"></i> My Account</a></li>
            <li><a class="dropdown-item" asp-controller="Cuenta" asp-action="Settings"><i class="bi bi-gear"></i> Settings</a></li>
            <li>
              <!-- Bloquea la pantalla sin cerrar sesión. bloqueo.js también envía este formulario tras 10 minutos sin actividad -->
              <form asp-controller="Bloqueo" asp-action="Bloquear" method="post" class="m-0" id="form-bloqueo" data-minutos-inactividad="10">
                <button type="submit" class="dropdown-item"><i class="bi bi-lock"></i> Lock Screen</button>
              </form>
            </li>
            <li>
              <hr class="dropdown-divider">
            </li>
            <li>
              <!-- Logout es un POST con token antiforgery: un link (GET) podría ser usado por otro sitio -->
              <form asp-controller="Home" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="dropdown-item text-danger">
                  <i class="bi bi-box-arrow-right"></i>
                  Logout
                </button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </header>

    @RenderBody()

    <!-- START: Footer Component -->
    <footer class="footer-custom">
      <div class="footer-left">
        <span class="footer-logo">
          <i class="bi bi-asterisk"></i> Spark Admin
        </span>
      </div>
    </footer>

  </div>

  <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="~/lib/apexcharts/apexcharts.min.js"></script>
  <script src="~/lib/flatpickr/flatpickr.min.js"></script>
  <script src="~/js/theme.js" asp-append-version="true"></script>
  <script src="~/js/dashboard.js" asp-append-version="true"></script>
  <script src="~/js/bloqueo.js" asp-append-version="true"></script>
</body>

</html>