@* Alertas de resultado de los formularios de la cuenta (patrón Post/Redirect/Get con TempData) *@
@if (TempData["Exito"] is string exito)
{
    <div class="alert alert-success" role="alert"><i class="bi bi-check-circle"></i> @exito</div>
}
@if (TempData["Advertencia"] is string advertencia)
{
    <div class="alert alert-warning" role="alert"><i class="bi bi-exclamation-circle"></i> @advertencia</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle"></i> @error</div>
}
@if (!string.IsNullOrEmpty(ViewBag.Mensaje))
{
    <div class="alert alert-warning" role="alert">@ViewBag.Mensaje</div>
}
