@using PAW_Jueves.Services
@model MovimientosViewModel
@{
    var periodo = $"{Model.Anno:0000}-{Model.Mes:00}";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
  <div>
    <h1 class="page-title">Movimientos</h1>
    <p class="page-subtitle">@FormatoMoneda.NombreMes(Model.Anno, Model.Mes) · @Model.Pagina.Total movimientos</p>
  </div>
  <div class="d-flex gap-2">
    <a asp-action="Crear" asp-route-tipo="G" class="btn-custom btn-custom-primary"><i class="bi bi-dash-circle"></i> Nuevo gasto</a>
    <a asp-action="Crear" asp-route-tipo="I" class="btn-custom btn-custom-light"><i class="bi bi-plus-circle"></i> Nuevo ingreso</a>
  </div>
</div>

<partial name="_Mensajes" />

<!-- Filtros (GET: quedan en la URL y se pueden compartir o recargar) -->
<form asp-action="Index" method="get" class="card p-3 border-light shadow-sm mb-4">
  <div class="row g-2 align-items-end">
    <div class="col-12 col-md-3">
      <label for="periodo" class="form-label-custom">Mes</label>
      <input id="periodo" name="periodo" type="month" class="form-control form-control-custom" value="@periodo">
    </div>
    <div class="col-6 col-md-3">
      <label for="tipo" class="form-label-custom">Tipo</label>
      <select id="tipo" name="tipo" class="form-select form-select-custom">
        <option value="" selected="@(Model.Tipo == null)">Todos</option>
        <option value="G" selected="@(Model.Tipo == "G")">Gastos</option>
        <option value="I" selected="@(Model.Tipo == "I")">Ingresos</option>
      </select>
    </div>
    <div class="col-6 col-md-4">
      <label for="idCategoria" class="form-label-custom">Categoría</label>
      <select id="idCategoria" name="idCategoria" class="form-select form-select-custom">
        <option value="">Todas</option>
        @foreach (var c in Model.Categorias)
        {
          <option value="@c.IdCategoria" selected="@(Model.IdCategoria == c.IdCategoria)">@c.Nombre</option>
        }
      </select>
    </div>
    <div class="col-12 col-md-2">
      <button type="submit" class="btn-custom btn-custom-secondary w-100"><i class="bi bi-funnel"></i> Filtrar</button>
    </div>
  </div>
</form>

<div class="card p-4 border-light shadow-sm">
  @if (!Model.Pagina.Datos.Any())
  {
    <p class="text-secondary text-center my-4">No hay movimientos con estos filtros.</p>
  }
  else
  {
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Categoría</th>
            <th>Descripción</th>
            <th class="text-end">Monto</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var m in Model.Pagina.Datos)
          {
            <tr>
              <td class="text-nowrap">@m.Fecha.ToString("dd/MM/yyyy")</td>
              <td class="text-nowrap">
                <span class="d-inline-block rounded-circle me-2 align-middle" style="width: 10px; height: 10px; background: @m.Color"></span>@m.Categoria
              </td>
              <td class="text-secondary">@(m.Descripcion ?? "—")</td>
              <td class="text-end text-nowrap fw-semibold @(m.Tipo == "I" ? "text-success" : "text-danger")">
                @(m.Tipo == "I" ? "+" : "−")@FormatoMoneda.Mostrar(m.Monto, Model.Moneda)
              </td>
              <td class="text-end text-nowrap">
                <a asp-action="Editar" asp-route-id="@m.IdMovimiento" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></a>
                <form asp-action="Eliminar" asp-route-id="@m.IdMovimiento" asp-route-periodo="@periodo" method="post" class="d-inline"
                      onsubmit="return confirm('¿Eliminar este movimiento?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>

    @if (Model.Pagina.TotalPaginas > 1)
    {
      <nav class="mt-3" aria-label="Paginación">
        <ul class="pagination justify-content-center mb-0">
          @for (var i = 1; i <= Model.Pagina.TotalPaginas; i++)
          {
            <li class="page-item @(i == Model.Pagina.Pagina ? "active" : "")">
              <a class="page-link" asp-action="Index" asp-route-periodo="@periodo" asp-route-tipo="@Model.Tipo"
                 asp-route-idCategoria="@Model.IdCategoria" asp-route-pagina="@i">@i</a>
            </li>
          }
        </ul>
      </nav>
    }
  }
</div>
