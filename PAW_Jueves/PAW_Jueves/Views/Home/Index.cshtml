@model List<ActividadModel>

<div class="page-header">
  <div>
    <h1 class="page-title">Hola, @Context.Session.GetString(ClavesSesion.NombreCompleto)</h1>
    <p class="page-subtitle">Este es su panel principal</p>
  </div>
</div>

<div class="row g-4">
  <div class="col-12 col-lg-6">
    <div class="card p-4 border-light shadow-sm h-100">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="card-title h5 mb-0"><i class="bi bi-clock-history"></i> Actividad reciente</h2>
        <a asp-controller="Cuenta" asp-action="MiCuenta" class="small">Ver más</a>
      </div>
      <partial name="_ActividadReciente" model="Model" />
    </div>
  </div>
</div>
